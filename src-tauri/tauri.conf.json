{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "antigravity-account-switcher",
  "version": "0.1.3-nightly.20260716",
  "identifier": "com.ximeeek.antigravity-account-switcher",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Account Switcher",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximizable": true,
        "shadow": true,
        "fullscreen": false,
        "decorations": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
